# Variables locales du worker (copier vers supabase/functions/.env pour `supabase start`).
# Le test de bout en bout démarre un faux serveur Expo sur ce port.
EXPO_PUSH_BASE_URL=http://host.docker.internal:8787
DISPATCH_SECRET=local-dispatch-secret
# Paiement (laisser vide en local : « billing_unavailable » est alors renvoyé proprement)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
SITE_URL=http://localhost:3000
# Test local du webhook (secret factice, utilisé par e2e/billing-flow.mjs)
STRIPE_WEBHOOK_SECRET=whsec_local_test
