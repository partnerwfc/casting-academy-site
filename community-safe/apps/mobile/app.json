{
  "expo": {
    "name": "SaveMyCommunity",
    "slug": "savemycommunity",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "savemycommunity",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.savemycommunity.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:savemycommunity.app"],
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.savemycommunity.app",
      "adaptiveIcon": {
        "backgroundColor": "#14082B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#14082B",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "savemycommunity.app", "pathPrefix": "/@" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-apple-authentication",
      ["expo-notifications", { "color": "#0755FF" }],
      "expo-iap",
      ["expo-camera", { "cameraPermission": "SaveMyCommunity utilise la caméra uniquement pour la vidéo selfie de certification (sans son).", "recordAudioAndroid": false }],
      ["expo-image-picker", { "photosPermission": "Choisis le logo de ta communauté." }],
      ["expo-splash-screen", { "backgroundColor": "#170B2F", "image": "./assets/images/splash-icon.png", "imageWidth": 76 }]
    ],
    "experiments": { "reactCompiler": true },
    "extra": {
      "eas": { "projectId": "d8e58d91-2361-4567-af88-b85004b43f73" }
    }
  }
}
